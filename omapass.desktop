[Desktop Entry]
Type=Application
Name=Omapass
GenericName=Password Manager
Comment=Password manager for KeePassXC and pass
Exec=omapass %f
Icon=omapass
Terminal=false
Categories=Utility;Security;
MimeType=application/x-keepass2;
Keywords=password;pass;keepassxc;kdbx;vault;secrets;
StartupWMClass=omapass
