# Maintainer: Higor Henrique <higorlhp2@gmail.com>
#
# Builds from the repository's current HEAD.
# There are no releases yet; when there are, this becomes a plain `omapass`
# with a source tarball and a fixed pkgver.

pkgname=omapass-git
pkgver=r0
pkgrel=1
_botanver=3.14.1
pkgdesc="Gerenciador de senhas em Qt Quick para KeePassXC, pass, Bitwarden e 1Password"
arch=('x86_64')
url="https://github.com/higorhgon/omapass"
# BSD-2-Clause: o Botan vai embutido no binario
license=('MIT' 'BSD-2-Clause')
depends=('qt6-base' 'qt6-declarative' 'hicolor-icon-theme' 'zlib')
makedepends=('git' 'qt6-tools' 'pkgconf' 'python')
# Os CLIs dos backends sao opcionais de proposito: cada um habilita um tipo
# de banco, e quem usa so o KeePass ou o Bitwarden (ambos falados direto,
# sem programa externo) nao precisa de nenhum. `omapass --doctor` diz o que foi encontrado.
optdepends=('1password-cli: contas 1Password'
            'pass: criar password-stores pela interface'
            'gnupg: bancos do pass'
            'libsecret: desbloqueio por PIN'
            'qt6-wayland: janela nativa em sessão Wayland (sem ele, via XWayland)'
            'fd: varredura de bancos ~5x mais rápida numa home grande'
            'wl-clipboard: limpeza automática do clipboard mais confiável em sessão Wayland'
            'xdg-desktop-portal: modo claro/escuro e tamanho de texto do desktop')
provides=('omapass')
conflicts=('omapass')
source=("$pkgname::git+$url.git"
        "https://botan.randombit.net/releases/Botan-$_botanver.tar.xz")
sha256sums=('SKIP'
            '5b85cba0f014d344eb8e9919aee0a3bdc31e16acb05816410025be9bee1e0930')

# O Botan e linkado estatico. O soname dele muda a cada versao menor
# (3.14 -> libbotan-3.so.14) e parte da ABI (a vtable do System_RNG) e
# gerada no proprio binario a partir dos headers: linkado dinamicamente, o
# pacote travava o `pacman -Syu` a cada Botan novo ou, sem a trava, caia ao
# desbloquear o Bitwarden. Embutido, o pacote nao depende do botan do sistema.
#
# So os algoritmos que o omapass pede ao Botan, mais as variantes x86 de
# cada um: o Botan escolhe a melhor em tempo de execucao pela CPU, e o
# AES-KDF e o Argon2 dos bancos KeePass dependem delas para abrir rapido.
# O sodium e a API compativel com o libsodium, para o crypto_box da
# integracao com o navegador; o configure traz o que ele exige (x25519,
# poly1305...).
_botan_modules=(
    aes aes_hwaes aes_vaes aes_vperm cbc
    chacha chacha_simd32 chacha_simd8x32 chacha_avx512
    salsa20 salsa20_simd32 salsa20_simd8x32 salsa20_avx512
    twofish twofish_avx512
    sha1 sha1_x86 sha1_simd sha1_avx2
    sha2_32 sha2_32_x86 sha2_32_simd sha2_32_avx2
    sha2_64 sha2_64_x86 sha2_64_avx2 sha2_64_avx512
    hmac hkdf pbkdf2
    argon2 argon2_simd64 argon2_simd4x64 argon2_avx512
    rsa eme_oaep system_rng
    sodium
)

pkgver() {
    cd "$srcdir/$pkgname"
    printf 'r%s.%s' "$(git rev-list --count HEAD)" "$(git rev-parse --short HEAD)"
}

# O omapass.pro acha o Botan pelo pkg-config: apontado para o estatico, ele
# vence o do sistema (se houver) sem mudar nada no projeto
_use_static_botan() {
    export PKG_CONFIG_PATH="$srcdir/botan/lib/pkgconfig"
}

build() {
    # O configure.py usa o CXXFLAGS do makepkg no lugar dos flags dele
    cd "$srcdir/Botan-$_botanver"
    python configure.py \
        --prefix="$srcdir/botan" \
        --build-targets=static \
        --minimized-build \
        --enable-modules="$(IFS=,; echo "${_botan_modules[*]}")" \
        --without-documentation \
        --no-install-python-module \
        --with-pkg-config
    make
    make install

    _use_static_botan
    cd "$srcdir/$pkgname"
    ./bin/build

    if readelf -d build/omapass | grep -q 'libbotan'; then
        echo "omapass foi linkado contra o libbotan do sistema, nao o estatico" >&2
        return 1
    fi
}

check() {
    _use_static_botan
    cd "$srcdir/$pkgname"
    ./bin/test
}

package() {
    # As bibliotecas do Qt tem simbolos versionados: o binario so roda com o
    # Qt com que foi compilado ou mais novo, entao o pacote exige essa versao
    local _qt
    _qt=$(qmake6 -query QT_VERSION | cut -d. -f1,2)
    depends=("${depends[@]/#qt6-base/qt6-base>=$_qt}")
    depends=("${depends[@]/#qt6-declarative/qt6-declarative>=$_qt}")

    # `make install` passa pelo ./bin/build de novo: sem isto o qmake
    # reencontraria o botan do sistema e religaria o binario contra ele
    _use_static_botan
    cd "$srcdir/$pkgname"
    make DESTDIR="$pkgdir" PREFIX=/usr install
    if readelf -d "$pkgdir/usr/bin/omapass" | grep -q 'libbotan'; then
        echo "omapass foi linkado contra o libbotan do sistema, nao o estatico" >&2
        return 1
    fi
    install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
    install -Dm644 "$srcdir/Botan-$_botanver/license.txt" \
        "$pkgdir/usr/share/licenses/$pkgname/LICENSE-Botan"
}
